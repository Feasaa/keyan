# 复制为 .env 后按需修改；.env 不要提交到版本库
# 字段名即 app/core/config.py 中的配置项名

PROJECT_NAME=learn-fastapi
VERSION=0.1.0
DEBUG=true

HOST=127.0.0.1
PORT=8000

# 复杂类型（List）用 JSON 写法
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ---- LLM（LangChain，OpenAI 兼容网关）----
# 不配置密钥 = 功能关闭：服务照常启动，/api/v1/llm/* 返回 503
LLM_API_KEY=
# 留空走 OpenAI 官方；填自建/第三方网关，如 https://api.deepseek.com/v1
LLM_BASE_URL=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.7

# ---- 提示词 ----
# 默认值来自 app/prompts/（system.py、assistant.py），此处留空即用代码内定义；
# 仅在需要按环境临时覆盖时才填写。
# LLM_SYSTEM_PROMPT=
# LLM_ASSISTANT_PROMPT=
