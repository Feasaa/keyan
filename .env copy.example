# 复制为 .env 后按需修改；.env 不要提交到版本库
# 字段名即 app/core/config.py 中的配置项名

PROJECT_NAME=learn-fastapi
VERSION=0.1.0
DEBUG=true

HOST=127.0.0.1
PORT=8000

# 复杂类型（List）用 JSON 写法
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ---- SSE ----
# ping 注释间隔（秒），需小于网关/负载均衡的空闲超时（常见 60s）
SSE_PING_SECONDS=15

# ---- LLM（LangChain，OpenAI 兼容网关）----
# 不配置密钥 = 功能关闭：服务照常启动，/api/v1/chat/* 返回 503
LLM_API_KEY=
# 留空走 OpenAI 官方；填自建/第三方网关，如 https://api.deepseek.com/v1
LLM_BASE_URL=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.7

# ---- 提示词 ----
# 正文在 app/prompts/files/*.md，这里只选"用哪个"。
# 切换提示词变体（灰度/租户）改这一项即可，不必改代码。
PROMPT_CHAT_SYSTEM_ID=chat_system

# ---- 雪花 ID ----
# 机器号 0-1023。单实例填 0；多实例部署时每台必须不同，否则会生成相同 ID。
SNOWFLAKE_WORKER_ID=0
