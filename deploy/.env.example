# 复制为 deploy/.env 后修改。.env 已被 .gitignore 忽略，不会进版本库。
# 这里的变量只服务于 docker-compose.yml，应用侧的配置在项目根 .env。

# ---- MySQL ----
# 生产环境请用 openssl rand -base64 24 之类的随机串，不要用这里的示例值
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_USER=app
MYSQL_PASSWORD=change-me-app

# 迁移专用账号（DDL 权限）。
# 配了它，app 账号会被收权成只有 DML —— 注入成功也删不掉表。
# 留空 = 不收权，仅适合"我知道我在干什么"的本地调试。
MYSQL_MIGRATOR_USER=migrator
MYSQL_MIGRATOR_PASSWORD=change-me-migrator

# 宿主机端口。改这里不用改容器内端口，也不用改应用配置里的 3306。
MYSQL_PORT=3306

# ---- Redis ----
REDIS_PASSWORD=change-me-redis
REDIS_PORT=6379
